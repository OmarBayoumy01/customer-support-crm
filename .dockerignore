# Keeps the build context small and the images clean. Everything the containers
# actually need arrives through the volume mount in docker-compose.yml, so the
# image only ever copies package manifests and the entrypoints.

node_modules
**/node_modules

dist
build
**/dist
**/build
.vite
.tsbuild
coverage
*.tsbuildinfo

# Generated by `prisma generate` inside the container, never copied in.
backend/src/generated

.git
.github
.husky
.squad

# Never bake a secret into an image layer.
.env
.env.*
!.env.example

.vscode
.idea
.DS_Store
Thumbs.db
