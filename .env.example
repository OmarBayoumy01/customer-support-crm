# Copy to `.env` at the repository root, then `docker compose up`.
#
# This file configures the CONTAINERS. It is separate from `backend/.env`, which
# configures the backend when you run it directly on the host — the two differ
# because a container reaches Postgres at `postgres:5432` while your machine
# reaches it at `localhost:5432`.
#
# Every value here has a working default, so `docker compose up` works with no
# `.env` at all. Copy it when you need to change a port or a credential.

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm_local_dev
POSTGRES_DB=crm

# Host-side port. Change it if something already owns 5432 on your machine;
# the containers always talk to each other on 5432 regardless.
POSTGRES_PORT=5432

# --- Redis ------------------------------------------------------------------
REDIS_PORT=6379

# --- Application ------------------------------------------------------------
BACKEND_PORT=3000
FRONTEND_PORT=5173

# One of: error | warn | info | debug | verbose
LOG_LEVEL=debug
