{
  "name": "@crm/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "dev": "node --watch dist/index.js",
    "dev:build": "tsc -b --watch --preserveWatchOutput",
    "dev:build:poll": "tsc -b --watch --preserveWatchOutput --watchFile priorityPollingInterval --watchDirectory dynamicPriorityPolling",
    "start": "node dist/index.js",
    "test": "tsc -b && node --env-file-if-exists=.env.test dist/testing/prepare-test-db.js && node --env-file-if-exists=.env.test --test \"dist/**/*.test.js\"",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@crm/shared": "*",
    "@nestjs/common": "11.2.3",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/swagger": "11.4.7",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bullmq": "5.65.0",
    "ioredis": "5.9.0",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.3",
    "@types/express": "5.0.6",
    "@types/node": "^24.3.0",
    "@types/pg": "8.23.1",
    "prisma": "7.10.0"
  }
}
