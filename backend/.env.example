# Copy to backend/.env and adjust. Never commit a real .env.
# Every variable here is declared in backend/src/config/env.schema.ts —
# if you add one there, add it here too.

# One of: development | test | staging | production
NODE_ENV=development

# TCP port for the HTTP server (1-65535)
PORT=3000

# Bind address. 0.0.0.0 inside containers, 127.0.0.1 for local-only.
HOST=0.0.0.0

# PostgreSQL connection string. Required — the service will not boot without it.
# Matches the container started by `npm run db:up --workspace @crm/backend`.
DATABASE_URL=postgresql://crm:crm_local_dev@127.0.0.1:5432/crm?schema=public

# Maximum connections held open by the pg pool (1-100).
DATABASE_POOL_SIZE=10

# How long to wait for a free connection before giving up, in milliseconds.
DATABASE_CONNECTION_TIMEOUT_MS=5000

# --- Logging ----------------------------------------------------------------
# One of: error | warn | info | debug | verbose. Each level enables itself and
# everything less verbose. Leave unset for the environment default — info in
# production, debug everywhere else.
# LOG_LEVEL=debug

# --- API documentation ------------------------------------------------------
# Where the Swagger UI is served. No leading slash.
SWAGGER_PATH=api/docs

# Outside production the docs are always on and these three do nothing.
# In production the docs are OFF unless this is true AND both credentials are
# set — enabling without credentials refuses to serve rather than failing open.
SWAGGER_ENABLED_IN_PRODUCTION=false
# SWAGGER_USER=docs
# SWAGGER_PASSWORD=set-a-real-one-in-the-deployment-environment

# --- Redis ------------------------------------------------------------------
# Cache, sessions, and background jobs. An unreachable Redis does NOT stop the
# service booting: the cache degrades and /health reports redis as down.
REDIS_URL=redis://127.0.0.1:6379/0

# Namespaces every cache key, so two environments sharing one Redis cannot read
# each other's entries.
REDIS_KEY_PREFIX=crm:
REDIS_CONNECT_TIMEOUT_MS=5000

# Default cache lifetime when a caller does not pass one, in seconds.
CACHE_TTL_SECONDS=300

# Background jobs: attempts before dead-lettering, and the exponential backoff base.
QUEUE_MAX_ATTEMPTS=3
QUEUE_BACKOFF_MS=1000

# --- Authentication (US-14) -------------------------------------------------
# Signs access tokens. Required, no default, minimum 32 characters. Generate a
# real one per environment with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789abcdef

# Reserved for US-15's refresh rotation. Same rules.
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-0123456789abcdef

# The `iss` claim, and what incoming tokens are checked against.
JWT_ISSUER=crm

# AC6: fifteen minutes. Refresh token lifetime is 30 days.
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# argon2id cost. Defaults are the OWASP minimum — 19 MiB, two passes, one lane.
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Brute-force thresholds (AC5). Per-email and per-IP are counted separately.
LOGIN_MAX_ATTEMPTS_PER_EMAIL=5
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_THROTTLE_WINDOW_SECONDS=900

# `Secure` on the refresh cookie. Must be true in every deployed environment;
# false locally only so the cookie survives plain http://localhost.
COOKIE_SECURE=false

# Password for the seeded development users. Unset means the seed creates no
# users. Never set in production — the seed refuses there regardless.
SEED_PASSWORD=DevPassw0rd!
