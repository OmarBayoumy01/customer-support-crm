# Copy to backend/.env and adjust. Never commit a real .env.
# Every variable here is declared in backend/src/config/env.schema.ts —
# if you add one there, add it here too.

# One of: development | test | staging | production
NODE_ENV=development

# TCP port for the HTTP server (1-65535)
PORT=3000

# Bind address. 0.0.0.0 inside containers, 127.0.0.1 for local-only.
HOST=0.0.0.0

# PostgreSQL connection string. Required — the service will not boot without it.
# Matches the container started by `npm run db:up --workspace @crm/backend`.
DATABASE_URL=postgresql://crm:crm_local_dev@127.0.0.1:5432/crm?schema=public

# Maximum connections held open by the pg pool (1-100).
DATABASE_POOL_SIZE=10

# How long to wait for a free connection before giving up, in milliseconds.
DATABASE_CONNECTION_TIMEOUT_MS=5000
