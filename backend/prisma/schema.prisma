// ============================================================================
// Core domain schema — US-6.
//
// Every later feature builds on this. Changing it after data exists is
// expensive, so it was reviewed in full before the first migration was written
// (see .squad/plans/domain-schema/00-overview.md for the decisions and their
// reasoning).
//
// Conventions used throughout:
//   - Primary keys are UUIDv7 — time-sortable, so index locality does not
//     degrade the way it does with v4.
//   - Short translated labels are `nameEn` / `nameAr` column pairs. Long
//     authored content (knowledge articles) is one row per locale instead.
//   - `createdAt` / `updatedAt` are maintained by Prisma. `deletedAt` marks a
//     soft delete and is filtered by the `notDeleted` client extension — see
//     src/prisma/soft-delete.extension.ts.
//   - Append-only tables (TicketHistory, AuditLog) have neither `updatedAt` nor
//     `deletedAt`. An audit trail you can edit is not an audit trail.
// ============================================================================

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"

  // Load-bearing — see US-5. Prisma's default emits `.ts` import specifiers,
  // which tsc copies verbatim into dist/ and Node cannot resolve.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Enums — AC3. Every one of these is a real PostgreSQL enum type, so an invalid
// value is rejected by the database, not merely by the application.
// ============================================================================

/// From the story's technical notes, in workflow order.
enum TicketStatus {
  NEW
  OPEN
  PENDING_CUSTOMER
  PENDING_INTERNAL
  ESCALATED
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// How a message reached us, or how a customer prefers to be reached.
enum Channel {
  EMAIL
  WHATSAPP
  CHAT
  SMS
  WEB
}

/// Who wrote a message. Kept separate from the nullable author columns so a
/// SYSTEM message (status change notices, auto-replies) needs no author row.
enum MessageSenderType {
  AGENT
  CUSTOMER
  SYSTEM
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum NotificationKind {
  TICKET_ASSIGNED
  TICKET_UPDATED
  TICKET_ESCALATED
  CUSTOMER_REPLIED
  MENTION
  TASK_ASSIGNED
  SLA_BREACH_WARNING
  SLA_BREACHED
  SYSTEM
}

enum ArticleStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

/// The platform ships in English and Arabic from day one, so locale is a
/// first-class enum rather than a free string that drifts into "en-GB", "EN",
/// and "english".
enum Locale {
  EN
  AR
}

/// How far a granted permission reaches. This is the mechanism behind the
/// project rule that scoped permissions are applied *in the database query*:
/// a guard reads the scope and the query adds the matching WHERE clause.
/// Filtering after fetching everything is never correct.
///
/// These four come from US-13. US-6 originally had OWN / DEPARTMENT / BRANCH /
/// ALL; `TEAM` replaces `DEPARTMENT` (same idea, the story's word) and
/// `ASSIGNED` was missing entirely — a ticket assigned to an agent is not one
/// that agent raised, and both need saying. `BRANCH` is gone; if branch-scoped
/// access is ever needed it comes back with the story that needs it.
enum PermissionScope {
  /// Everything. No filter is added.
  ALL

  /// The user's own department.
  TEAM

  /// Records assigned to the user — their ticket queue.
  ASSIGNED

  /// Records belonging to the user. For a portal customer, their own tickets.
  OWN
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  PERMISSION_CHANGE
  EXPORT
}

/// What happened to a ticket. TicketHistory is the per-ticket timeline the UI
/// renders; AuditLog is the platform-wide compliance trail. They are different
/// readers with different retention needs, which is why they are separate.
enum TicketEventType {
  CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNED
  UNASSIGNED
  CATEGORY_CHANGED
  DEPARTMENT_CHANGED
  ESCALATED
  SLA_BREACHED
  REOPENED
  CLOSED
}

// ============================================================================
// Identity and access
// ============================================================================

/// Every authenticated principal — agents, managers, administrators, and
/// portal customers alike.
///
/// A portal customer has BOTH a User row (credentials, session, locale) and a
/// Customer row (the CRM record), linked by Customer.userId. One authentication
/// path means password hashing, lockout, and token revocation are implemented
/// once in P02 rather than twice. What a portal user may see is a matter of
/// roles and scopes, not of which table their password lives in.
model User {
  id           String    @id @default(uuid(7))
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  avatarUrl    String?
  locale       Locale    @default(EN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  branchId     String?
  branch       Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)

  roles               UserRole[]
  sessions            Session[]
  customerProfile     Customer?
  assignedTickets     Ticket[]           @relation("TicketAssignee")
  escalatedTickets    Ticket[]           @relation("TicketEscalatedTo")
  authoredMessages    Message[]          @relation("MessageAuthorUser")
  uploadedAttachments Attachment[]
  ticketEvents        TicketHistory[]
  managedDepartments  Department[]       @relation("DepartmentManager")
  assignedTasks       Task[]             @relation("TaskAssignee")
  createdTasks        Task[]             @relation("TaskCreatedBy")
  notifications       Notification[]
  authoredArticles    KnowledgeArticle[]
  auditLogs           AuditLog[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([departmentId, isActive])
  @@index([branchId, isActive])
  @@index([deletedAt])
}

/// A named bundle of permissions. `key` is the stable machine name the code
/// checks ("agent", "manager", "administrator", "customer"); the display names
/// are per-locale because the admin UI in P14 lists roles in both languages.
model Role {
  id          String  @id @default(uuid(7))
  key         String  @unique
  nameEn      String
  nameAr      String
  description String?

  /// System roles cannot be deleted or renamed by administrators. Guards the
  /// case where someone removes "administrator" and locks everyone out.
  isSystem Boolean @default(false)

  users       UserRole[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One capability. `key` is what code checks and is derived from
/// resource + action so the two can never disagree: "ticket.assign",
/// "customer.read", "report.export".
model Permission {
  id          String  @id @default(uuid(7))
  key         String  @unique
  resource    String
  action      String
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([resource, action])
  @@index([resource])
}

/// Explicit join rather than an implicit many-to-many, so we can record who
/// granted a role and when — which P14's audit requirements will want.
model UserRole {
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt   DateTime @default(now())
  assignedById String?

  @@id([userId, roleId])
  @@index([roleId])
}

/// Explicit join, because the scope lives on the grant. The same permission
/// means different things to different roles: an agent reads tickets with scope
/// OWN, a manager with scope DEPARTMENT, an administrator with scope ALL.
model RolePermission {
  roleId       String
  role         Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission      @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  scope        PermissionScope @default(OWN)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

/// One issued refresh token — US-14.
///
/// The access token is stateless and short-lived; this is the half that can be
/// revoked. It is a table rather than a claim because US-16 ("sign out and
/// revoke sessions") has to be able to end a session that has already been
/// handed out, and you cannot un-issue a signed JWT.
///
/// Concurrent rows per user are normal and correct — a laptop and a phone are
/// two sessions, not a conflict.
model Session {
  id String @id @default(uuid(7))

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the refresh token, never the token itself. A leaked database
  /// backup must not hand out live sessions.
  ///
  /// SHA-256 rather than argon2 on purpose: this is 256 bits of `randomBytes`,
  /// not a human-chosen password, so there is no dictionary to attack and a
  /// deliberately slow hash would only tax every refresh. Passwords are a
  /// different problem and get argon2id — see PasswordService.
  refreshTokenHash String @unique

  /// Which front door the session was opened at — `crm-staff` or `crm-portal`.
  /// Stored so a portal refresh token can never mint a staff access token when
  /// US-21 adds the second door.
  audience String

  expiresAt DateTime
  revokedAt DateTime?

  ipAddress String?
  userAgent String?

  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  /// Listing a user's live sessions — what US-16's UI reads.
  @@index([userId, revokedAt])
  /// Cleaning up expired rows. See SessionService.deleteExpired().
  @@index([expiresAt])
}

// ============================================================================
// Organisation
// ============================================================================

model Branch {
  id      String  @id @default(uuid(7))
  code    String  @unique
  nameEn  String
  nameAr  String
  city    String?
  country String?

  /// IANA name. SLA clocks and business hours are computed per branch, so this
  /// has to be stored rather than assumed from the server's locale.
  timezone String @default("Asia/Riyadh")

  isActive Boolean @default(true)

  users       User[]
  departments Department[]
  customers   Customer[]
  tickets     Ticket[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([isActive])
}

model Department {
  id          String  @id @default(uuid(7))
  code        String  @unique
  nameEn      String
  nameAr      String
  description String?

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  managerId String?
  manager   User?   @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)

  isActive Boolean @default(true)

  members     User[]
  categories  Category[]
  tickets     Ticket[]
  slaPolicies SlaPolicy[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([branchId, isActive])
}

// ============================================================================
// Customers
// ============================================================================

model Customer {
  id String @id @default(uuid(7))

  /// Present only once the customer has portal access. Optional because most
  /// customers are created by an agent taking a phone call long before they
  /// ever log in.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  firstName   String
  lastName    String
  email       String?
  phone       String?
  companyName String?

  preferredLocale  Locale   @default(EN)
  preferredChannel Channel?

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  /// Identifier in a customer's own system, for the ERP integration in P13.
  externalRef String?

  isActive Boolean @default(true)

  tickets  Ticket[]
  messages Message[] @relation("MessageAuthorCustomer")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([email])
  @@index([phone])
  @@index([branchId, isActive])
  @@index([lastName, firstName])
  @@index([externalRef])
}

// ============================================================================
// Categorisation
// ============================================================================

/// A tree, one level or many. `parentId` is self-referential with SetNull so
/// deleting a parent promotes its children rather than deleting them.
model Category {
  id            String  @id @default(uuid(7))
  slug          String  @unique
  nameEn        String
  nameAr        String
  descriptionEn String?
  descriptionAr String?

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  /// Routing hints applied when a ticket is categorised.
  departmentId    String?
  department      Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  defaultPriority TicketPriority?

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  tickets  Ticket[]
  articles KnowledgeArticle[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([parentId, sortOrder])
  @@index([departmentId, isActive])
}

// ============================================================================
// Tickets — the core of the platform
// ============================================================================

model Ticket {
  id String @id @default(uuid(7))

  /// The human-facing reference: "#1043". Sequential and unique, generated by
  /// PostgreSQL, so two concurrent submissions cannot collide.
  number Int @unique @default(autoincrement())

  subject     String
  description String?

  status   TicketStatus   @default(NEW)
  priority TicketPriority @default(MEDIUM)
  channel  Channel        @default(WEB)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  assigneeId String?
  assignee   User?   @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  // --- SLA state -----------------------------------------------------------
  // Deliberately denormalised onto the ticket rather than kept in a join.
  // The SLA monitor sweeps "every open ticket whose due date has passed", and
  // the agent list sorts by time remaining; both are hot paths that must hit an
  // index on this table rather than join out to another one on every read.
  slaPolicyId String?
  slaPolicy   SlaPolicy? @relation(fields: [slaPolicyId], references: [id], onDelete: SetNull)

  firstResponseDueAt    DateTime?
  firstRespondedAt      DateTime?
  firstResponseBreached Boolean   @default(false)
  resolutionDueAt       DateTime?
  resolutionBreached    Boolean   @default(false)

  resolvedAt DateTime?
  closedAt   DateTime?

  escalatedAt   DateTime?
  escalatedToId String?
  escalatedTo   User?     @relation("TicketEscalatedTo", fields: [escalatedToId], references: [id], onDelete: SetNull)

  /// Reopening is a quality signal the P11 reports care about, so it is counted
  /// rather than inferred from history.
  reopenCount Int @default(0)

  /// Kept current so "waiting on us" versus "waiting on them" is a column
  /// comparison instead of a correlated subquery over messages.
  lastCustomerReplyAt DateTime?
  lastAgentReplyAt    DateTime?

  tags String[] @default([])

  /// Channel-specific provenance: the email Message-ID, the WhatsApp thread id,
  /// the web form used. Json because each channel in P13 carries a different
  /// shape, and none of it is queried.
  sourceMetadata Json?

  messages      Message[]
  attachments   Attachment[]
  history       TicketHistory[]
  tasks         Task[]
  notifications Notification[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // --- AC5: indexes on the hot paths ---------------------------------------
  // The agent queue: "my open tickets, most recently touched first".
  @@index([assigneeId, status, updatedAt(sort: Desc)])
  // The manager queue: the same question asked for a whole department.
  @@index([departmentId, status, updatedAt(sort: Desc)])
  // The default list view and every "all open tickets" filter.
  @@index([status, updatedAt(sort: Desc)])
  @@index([status, priority, updatedAt(sort: Desc)])
  // The customer's own history, and the portal's request list.
  @@index([customerId, createdAt(sort: Desc)])
  // The SLA sweep: find everything about to breach or already breached.
  @@index([status, resolutionDueAt])
  @@index([status, firstResponseDueAt])
  @@index([branchId, status])
  @@index([categoryId])
  @@index([deletedAt])
}

/// A single entry in a ticket conversation.
///
/// ┌──────────────────────────────────────────────────────────────────────┐
/// │ NON-NEGOTIABLE PROJECT RULE                                          │
/// │                                                                      │
/// │ `isInternal = true` means this message must NEVER reach a customer.  │
/// │ Not in a portal response, not in an email, not in an attachment      │
/// │ listing, not in a notification body, not in a search result.         │
/// │                                                                      │
/// │ The filter belongs in the API layer's query — `where: { isInternal:  │
/// │ false }` — never in the UI. There is an explicit regression test for  │
/// │ this, and it is not optional.                                        │
/// └──────────────────────────────────────────────────────────────────────┘
///
/// Not null and defaulting to false: a message whose visibility is unknown
/// must fall on the safe side, and a nullable flag would make `isInternal !=
/// true` and `isInternal = false` differ — a trap worth closing at the schema.
model Message {
  id       String @id @default(uuid(7))
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  isInternal Boolean @default(false)

  senderType MessageSenderType

  authorUserId String?
  authorUser   User?   @relation("MessageAuthorUser", fields: [authorUserId], references: [id], onDelete: SetNull)

  authorCustomerId String?
  authorCustomer   Customer? @relation("MessageAuthorCustomer", fields: [authorCustomerId], references: [id], onDelete: SetNull)

  body String

  /// The channel this specific message arrived on or was sent through, which
  /// can differ from the ticket's original channel over a long conversation.
  channel Channel?

  /// Provider-side id, for de-duplicating inbound email and WhatsApp in P13.
  externalMessageId String?

  attachments Attachment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// The conversation view, in order.
  @@index([ticketId, createdAt])
  /// The customer-facing view. Leading with isInternal keeps the portal's
  /// filtered read on an index instead of scanning the thread.
  @@index([ticketId, isInternal, createdAt])
  @@unique([channel, externalMessageId])
  @@index([authorUserId])
}

/// A stored file.
///
/// An attachment hangs off a Message, never off a Ticket directly. That is a
/// deliberate consequence of the internal-notes rule: visibility is decided in
/// exactly one place, and an attachment on an internal note is internal by
/// construction rather than by remembering to check. `ticketId` is carried
/// alongside as a denormalised shortcut for "every file on this ticket", and is
/// always the parent message's ticket.
model Attachment {
  id        String  @id @default(uuid(7))
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  fileName    String
  contentType String
  sizeBytes   Int

  /// Object key in S3-compatible storage. Unique so the same object cannot be
  /// referenced by two rows and deleted out from under one of them.
  storageKey String  @unique
  checksum   String?

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([messageId])
  @@index([ticketId])
}

/// The per-ticket timeline: what changed, when, and who did it.
///
/// Append-only, so there is no updatedAt and no deletedAt — an audit trail you
/// can edit is not an audit trail.
model TicketHistory {
  id       String @id @default(uuid(7))
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  actorUserId String?
  actor       User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  eventType TicketEventType

  /// Which column moved, and from what to what. Strings because the same three
  /// columns describe a status change, a priority change, and a reassignment.
  field     String?
  fromValue String?
  toValue   String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([eventType, createdAt])
}

// ============================================================================
// SLA
// ============================================================================

/// One row per (priority, department) pair, rather than one policy row holding
/// eight columns of per-priority targets. Adding a priority then adds rows, not
/// columns, and a department that needs no override simply has no row —
/// departmentId NULL is the platform default.
model SlaPolicy {
  id     String @id @default(uuid(7))
  nameEn String
  nameAr String

  priority TicketPriority

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  firstResponseMinutes Int
  resolutionMinutes    Int

  /// When true the clock only advances during the branch's business hours.
  /// The calendar itself arrives with P08; this is the flag it will read.
  businessHoursOnly Boolean @default(true)

  isActive Boolean @default(true)

  tickets Ticket[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// At most one policy per priority per department, and exactly one platform
  /// default per priority (departmentId NULL).
  @@unique([priority, departmentId])
  @@index([isActive])
}

// ============================================================================
// Work management
// ============================================================================

model Task {
  id          String  @id @default(uuid(7))
  title       String
  description String?

  /// Optional: a task may stand alone ("call the supplier") or hang off a
  /// ticket ("chase the customer for a screenshot").
  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  status   TaskStatus     @default(TODO)
  priority TicketPriority @default(MEDIUM)

  dueAt       DateTime?
  completedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([assigneeId, status, dueAt])
  @@index([ticketId])
  @@index([status, dueAt])
}

model Notification {
  id     String @id @default(uuid(7))
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind NotificationKind

  /// Rendered client-side from `kind` + `payload` so a notification stays
  /// correct in whichever language the reader has chosen — storing a rendered
  /// English string would freeze the wrong locale into the row.
  payload Json

  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  readAt DateTime?

  createdAt DateTime @default(now())

  /// The unread badge, and the notification centre's list.
  @@index([userId, readAt])
  @@index([userId, createdAt(sort: Desc)])
}

// ============================================================================
// Knowledge base
// ============================================================================

/// One row per language, not one row with two bodies.
///
/// Article bodies are long, are authored and published independently, and an
/// Arabic translation frequently lags its English original or never appears.
/// `translationGroupId` ties the versions together; the reader gets their
/// locale if it exists and falls back if it does not. This is the one place
/// where per-locale columns would be wrong — everywhere else in this schema
/// the translated strings are short labels, so nameEn/nameAr pairs are simpler.
model KnowledgeArticle {
  id String @id @default(uuid(7))

  /// Shared by every language version of the same article.
  translationGroupId String
  locale             Locale

  title   String
  slug    String
  excerpt String?
  body    String

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  status ArticleStatus @default(DRAFT)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  publishedAt DateTime?
  viewCount   Int       @default(0)
  tags        String[]  @default([])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([translationGroupId, locale])
  @@unique([locale, slug])
  @@index([status, publishedAt(sort: Desc)])
  @@index([categoryId, status])
}

// ============================================================================
// Audit
// ============================================================================

/// Platform-wide, compliance-facing, append-only.
///
/// Distinct from TicketHistory on purpose: this one records logins, permission
/// changes, exports, and administrative edits across every entity, is read by
/// administrators rather than agents, and will outlive the rows it describes —
/// hence `entityId` as a plain string with no foreign key.
model AuditLog {
  id String @id @default(uuid(7))

  actorUserId String?
  actor       User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  action     AuditAction
  entityType String
  entityId   String?

  /// Before and after images of the changed fields only, never the whole row.
  /// Secrets and password hashes must never be written here.
  before Json?
  after  Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}
