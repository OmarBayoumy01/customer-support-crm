# Committed on purpose — this is the one exception to "never commit .env files",
# declared in the repository .gitignore.
#
# It holds localhost-only, throwaway credentials for the test database so that
# `npm run verify` works from a clean clone. NEVER put a real credential here.
#
# Real environments supply DATABASE_URL as an actual environment variable, which
# takes precedence over this file.

NODE_ENV=test

# Separate database from development. `npm run db:create-test` creates it.
DATABASE_URL=postgresql://crm:crm_local_dev@127.0.0.1:5432/crm_test?schema=public

# PORT is deliberately not set. Tests call app.listen(0) so the OS picks a free
# port; the schema requires a positive PORT, so 0 cannot be expressed here.

# Deliberately small, so the pooling test (AC4) can drive the pool to its limit
# with a modest number of concurrent queries.
DATABASE_POOL_SIZE=5

# Redis for the test run. Uses database 1 so a local dev cache in db 0 is
# never flushed by the suite.
REDIS_URL=redis://127.0.0.1:6379/1
REDIS_KEY_PREFIX=crm-test:

# --- Authentication (US-14) -------------------------------------------------
# Throwaway, localhost-only, exactly like the database credentials above.
JWT_ACCESS_SECRET=test-only-access-secret-0123456789abcdefghijklmnop
JWT_REFRESH_SECRET=test-only-refresh-secret-0123456789abcdefghijklmnop
JWT_ISSUER=crm-test

# argon2 at its floor: the suite hashes on nearly every test, and the security
# margin of 19 MiB buys nothing against credentials that exist only in memory
# for the length of one run. Production uses the schema defaults.
ARGON2_MEMORY_COST=8192
ARGON2_TIME_COST=1
ARGON2_PARALLELISM=1

# Small window so the throttle test does not have to wait out a real lockout.
LOGIN_THROTTLE_WINDOW_SECONDS=60

# Effectively off for the suite. Every test signs in from 127.0.0.1, so a
# realistic per-IP threshold would trip partway through the run and fail
# unrelated tests. The per-IP counter is exercised directly, with its own
# threshold, in login-throttle.test.ts.
LOGIN_MAX_ATTEMPTS_PER_IP=100000
